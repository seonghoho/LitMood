# ─────────────────────────────────────────────────────────────
# LitMood 환경변수 템플릿
#   백엔드: apps/api/.env.local 로 복사해 사용
#   프론트: apps/web/.env.local 로 복사해 사용 (NEXT_PUBLIC_* 만 필요)
#
# ⚠️ 실제 값이 들어간 파일은 절대 커밋하지 않는다 (docs/06-infra.md)
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/litmood
DB_USERNAME=litmood
DB_PASSWORD=litmood_local

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────
# 생성: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# ── 외부 Content Provider (ADR-010) ───────────────────────
# 서버 전용. 프론트엔드 번들에 절대 포함하지 않는다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
TMDB_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── OAuth2 ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ── 운영자 (#28) ──────────────────────────────────────────
# 신고 처리 화면(/admin/reports)에 들어갈 수 있는 계정의 handle. 쉼표로 구분한다.
# 대소문자를 구분하며, 여기 적는 핸들은 이미 존재하는 계정이어야 한다 —
# 없는 핸들을 적어 두면 그 이름으로 먼저 가입하는 사람이 운영자가 된다 (기동 시 경고).
ADMIN_HANDLES=

# ── Object Storage (MinIO / S3) ───────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=litmood
S3_ACCESS_KEY=litmood
S3_SECRET_KEY=litmood_local

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 서버 컴포넌트 → 백엔드 직접 호출용 (컨테이너 내부에서는 서비스명 사용)
API_INTERNAL_BASE_URL=http://localhost:8080
