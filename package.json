{
  "name": "litmood",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "infra:up": "docker compose -f infra/docker/compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/compose.yml down",
    "infra:reset": "docker compose -f infra/docker/compose.yml down -v && pnpm infra:up",
    "api:dev": "./scripts/dev-api.sh",
    "api:test": "cd apps/api && ./gradlew test",
    "stub": "node tools/stub-provider/server.mjs",
    "api:dev:stub": "./scripts/dev-api.sh --stub",
    "doctor": "./scripts/doctor.sh",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm api:test"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp"
    ]
  }
}
